{
  "name": "tauri-desktop-template",
  "version": "0.1.0",
  "description": "Desktop application development template based on Tauri and Svelte.",
  "license": "GPL-3.0-only",
  "author": "Alfred Clark",
  "homepage": "https://github.com/alfredclark/tauri-desktop-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfredclark/tauri-desktop-template.git"
  },
  "bugs": {
    "url": "https://github.com/alfredclark/tauri-desktop-template/issues"
  },
  "keywords": [
    "tauri",
    "desktop",
    "template"
  ],
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:local": "tauri build --no-bundle",
    "tauri:icon": "tauri icon static/icon.png && rimraf src-tauri/icons/ios src-tauri/icons/android",
    "i18n:compile": "paraglide-js compile --project ./src/libs/i18n/project.inlang --outdir ./src/libs/i18n/paraglide --strategy localStorage baseLocale --emit-ts-declarations",
    "i18n:translate": "inlang machine translate --project src/libs/i18n/project.inlang",
    "clean": "rimraf build/ node_modules/.vite .svelte-kit target/",
    "clean:frontend": "rimraf build/ node_modules/.vite .svelte-kit",
    "clean:backend": "rimraf target/",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "prettier --check . && eslint .",
    "lint:backend": "cargo clippy --manifest-path Cargo.toml --workspace --all-targets -- -D warnings",
    "format": "pnpm format:frontend && pnpm format:backend",
    "format:frontend": "prettier --write . && eslint --fix .",
    "format:backend": "cargo fmt --manifest-path Cargo.toml --all",
    "validate": "pnpm lint && pnpm check",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased",
    "release": "bumpp package.json src-tauri/tauri.conf.json src-tauri/Cargo.toml --all --commit \"chore(release): prepare for {tag}\" --push false",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "mode-watcher": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inlang/cli": "^3.3.4",
    "@inlang/paraglide-js": "^2.25.0",
    "@inlang/paraglide-js-svelte": "^1.0.4",
    "@inlang/plugin-m-function-matcher": "^2.2.13",
    "@inlang/plugin-message-format": "^4.4.4",
    "@lucide/svelte": "^1.40.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.1",
    "bumpp": "^12.3.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "git-cliff": "^2.13.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-sort-imports": "^1.8.11",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.6.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
