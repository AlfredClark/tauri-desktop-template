{
  "name": "tauri-desktop-template",
  "version": "0.1.0",
  "description": "Tauri based desktop application development template",
  "license": "GPL-3.0-only",
  "author": "Alfred Clark",
  "homepage": "https://github.com/alfredclark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfredclark/tauri-desktop-template.git"
  },
  "bugs": {
    "url": "https://github.com/alfredclark/tauri-desktop-template/issues"
  },
  "keywords": [
    "tauri",
    "desktop",
    "template"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "validate": "bun run lint:all && bun run format:all:check && bun run check:rust && bun run check",
    "validate:js": "eslint . && stylelint \"src/**/*.{css,svelte}\" && prettier --check . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "i18n:compile": "paraglide-js compile --project ./src/libs/i18n/project.inlang --outdir ./src/libs/i18n/paraglide --strategy localStorage baseLocale --emit-ts-declarations",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:rust": "cargo check",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "lint:css:fix": "stylelint --fix \"src/**/*.{css,svelte}\"",
    "lint:rust": "cargo clippy -- -D warnings",
    "lint:all": "eslint . && stylelint \"src/**/*.{css,svelte}\" && cargo clippy -- -D warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:rust": "cargo fmt",
    "format:rust:check": "cargo fmt --check",
    "format:all": "prettier --write . && cargo fmt",
    "format:all:check": "prettier --check . && cargo fmt --check"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "eslint --fix"
    ],
    "*.{css,svelte}": [
      "stylelint --fix"
    ],
    "*.rs": [
      "rustfmt"
    ],
    "*": [
      "prettier --write --ignore-unknown"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "tauri-plugin-system-fonts-api": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.23.1",
    "@inlang/paraglide-js-svelte": "^1.0.3",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.28.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
