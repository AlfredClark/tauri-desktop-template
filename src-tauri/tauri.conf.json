{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-desktop-template",
  "version": "0.1.0",
  "identifier": "io.github.alfredclark.tauri-desktop-template",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "title": "Tauri Desktop Template",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true
      }
    ],
    "security": {
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' http://localhost:1420 asset: http://asset.localhost blob: data:",
        "font-src": "'self'",
        "object-src": "'none'"
      },
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
