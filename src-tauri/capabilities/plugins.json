{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugins",
  "description": "Plugin permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "opener:default",
    "log:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/*" }]
    },
    "system-fonts:default",
    "os:default",
    "global-shortcut:default",
    "updater:default",
    "process:default"
  ]
}
